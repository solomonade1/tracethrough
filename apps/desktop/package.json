{
  "name": "@tracethrough/desktop",
  "productName": "TraceThrough",
  "version": "0.3.0",
  "description": "Network inspector: open a URL in a clean Chrome or Edge window and inspect every request, plus your Node.js or Next.js server's fetch calls.",
  "author": "TraceThrough",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win --x64 --config electron-builder.config.cjs",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --config electron-builder.config.cjs",
    "build:web": "vite build --config vite.web.config.ts",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.config.cjs",
    "dist:linux": "electron-vite build && electron-builder --linux --config electron-builder.config.cjs"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@tanstack/react-virtual": "^3.14.25",
    "@tracethrough/capture": "workspace:*",
    "@tracethrough/collector": "workspace:*",
    "@tracethrough/core": "workspace:*",
    "@tracethrough/fixtures": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "zustand": "^5.0.16"
  }
}
