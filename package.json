{
  "name": "tracethrough",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/desktop/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "tsx scripts/spike.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "browsers:install": "playwright install chromium",
    "test:e2e": "pnpm --filter @tracethrough/desktop build && vitest run --config apps/desktop/vitest.config.ts",
    "app": "pnpm --filter @tracethrough/desktop dev",
    "web": "pnpm --filter @tracethrough/desktop build:web && tsx apps/desktop/src/web/cli.ts",
    "example:node": "pnpm --filter @tracethrough/example-node-app start",
    "test:e2e:next": "pnpm --filter @tracethrough/desktop build && vitest run --config apps/desktop/vitest.next.config.ts",
    "example:next": "pnpm --filter @tracethrough/example-next-app dev",
    "smoke:next": "tsx scripts/next-smoke.ts",
    "smoke:packages": "tsx scripts/smoke-packages.ts",
    "test:next-matrix": "vitest run --config vitest.next-matrix.config.ts",
    "package:win": "pnpm --filter @tracethrough/desktop dist:win",
    "build:packages": "pnpm --filter @tracethrough/core --filter @tracethrough/node --filter @tracethrough/next build",
    "changeset": "changeset",
    "release": "pnpm build:packages && changeset publish",
    "package:mac": "pnpm --filter @tracethrough/desktop dist:mac",
    "package:linux": "pnpm --filter @tracethrough/desktop dist:linux"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@tracethrough/capture": "workspace:*",
    "@tracethrough/collector": "workspace:*",
    "@tracethrough/core": "workspace:*",
    "@tracethrough/fixtures": "workspace:*",
    "@types/node": "^20.19.43",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
