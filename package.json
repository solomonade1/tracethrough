{
  "name": "tracelens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/desktop/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "tsx scripts/spike.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "browsers:install": "playwright install chromium",
    "test:e2e": "pnpm --filter @tracelens/desktop build && vitest run --config apps/desktop/vitest.config.ts",
    "app": "pnpm --filter @tracelens/desktop dev"
  },
  "devDependencies": {
    "@tracelens/capture": "workspace:*",
    "@tracelens/core": "workspace:*",
    "@tracelens/fixtures": "workspace:*",
    "@types/node": "^20.19.43",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
